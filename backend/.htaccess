<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose project files or dotfiles from the repository root.
    RewriteRule ^(?:\.|.*\.(?:env|json|lock|md|xml|ya?ml|log|sql|bak))$ - [F,L,NC]

    # The public directory is an implementation detail; map public assets here.
    RewriteRule ^public(?:/|$) - [F,L,NC]
    RewriteRule ^(?:build|storage|favicon\.ico|robots\.txt)(?:/.*)?$ public/$0 [END]

    # Run every other request through Laravel's public front controller.
    RewriteRule ^ public/index.php [END]
</IfModule>
